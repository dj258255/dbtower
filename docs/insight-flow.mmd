---
config:
  look: handDrawn
  handDrawnSeed: 31
  theme: base
  htmlLabels: true
  flowchart:
    curve: basis
  themeVariables:
    fontFamily: "Pretendard, Apple SD Gothic Neo, sans-serif"
    primaryTextColor: "#172033"
    lineColor: "#52606d"
---
flowchart TB
  subgraph diagnose["관측에서 변경 요청까지"]
    direction LR
    detect["1. 발견<br/>헬스 · Top Query · 경보"]:::observe
    compare["2. 비교<br/>두 구간의 누적 카운터 차분"]:::observe
    facts["3. 결정론적 근거<br/>실행계획 · 스키마 · wait · 복제"]:::reason
    ai["4. AI 1차 분석<br/>읽기 도구 선택 · 진행 상황 스트리밍"]:::ai
    request["5. 변경 요청<br/>SQL · 이유 · 예상 영향"]:::request
    detect --> compare --> facts --> ai --> request
  end

  subgraph govern["사람의 승인과 실행 계층의 검증"]
    direction LR
    approve{"APPROVER<br/>드라이런 · 승인"}:::gate
    execute["OPERATOR<br/>승인 티켓 실행"]:::gate
    verify{"사본 행 수 = 영향 행 수?<br/>실행 직후 상태가 같은가?"}:::invariant
    evidence["6. 결과 고정<br/>감사 · 실행 기록 · 전후 비교"]:::result
    rollback["조건부 되돌리기<br/>파라미터 바인딩"]:::result
    reject["반려 또는 롤백<br/>커밋하지 않음"]:::stop
    approve -->|승인| execute --> verify
    approve -->|반려| reject
    verify -->|일치| evidence
    verify -->|불일치| reject
    evidence -. 필요 시 .-> rollback
  end

  diagnose -->|변경 요청 제출| govern

  policy["항상 유지되는 경계<br/>AI는 판단자·실행자가 아님<br/>요청자 ≠ 승인자 · 승인자 ≠ 실행자<br/>대상·팀 범위·읽기 전용은 코드가 강제"]:::policy
  policy -.-> diagnose
  policy -.-> govern

  classDef observe fill:#e8f7f2,stroke:#087f5b,color:#084c3c
  classDef reason fill:#fff7d6,stroke:#b7791f,color:#633c0c
  classDef ai fill:#f3e8ff,stroke:#7e22ce,color:#4a1768
  classDef request fill:#eaf4ff,stroke:#1971c2,color:#103d67
  classDef gate fill:#fff0f0,stroke:#c92a2a,color:#6b1717,stroke-width:2px
  classDef invariant fill:#fff4e6,stroke:#d9480f,color:#6c2b0d,stroke-width:2px
  classDef result fill:#edf2f7,stroke:#334155,color:#172033
  classDef stop fill:#ffffff,stroke:#c92a2a,color:#6b1717
  classDef policy fill:#f8fafc,stroke:#475569,color:#172033,stroke-dasharray: 5 4
