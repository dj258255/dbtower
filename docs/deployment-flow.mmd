---
config:
  look: handDrawn
  handDrawnSeed: 43
  theme: base
  htmlLabels: true
  flowchart:
    curve: basis
  themeVariables:
    fontFamily: "Pretendard, Apple SD Gothic Neo, sans-serif"
    primaryTextColor: "#172033"
    lineColor: "#52606d"
---
flowchart TB
  source["GitHub<br/>Pull Request · main · vX.Y.Z tag"]:::source

  subgraph ci["CI · 변경을 합치기 전"]
    direction LR
    convention["규약 검사<br/>모듈 경계 · 보안 기준선"]:::ci
    browser["Playwright<br/>Chromium 설치"]:::ci
    test["Java 21 전체 테스트<br/>5개 역할 UI E2E 포함"]:::ci
    guard["JUnit XML<br/>skipped = 0 확인"]:::gate
    report["실패 리포트<br/>Artifact"]:::artifact
    convention --> browser --> test --> guard
    guard -. 실패 .-> report
  end

  subgraph release["Release · 태그 또는 수동 실행"]
    direction LR
    rtest["전체 테스트"]:::release
    qemu["QEMU + Buildx"]:::release
    image["멀티스테이지 이미지<br/>JRE · UID 1001 · HEALTHCHECK"]:::release
    ghcr[("GHCR<br/>amd64 + arm64<br/>SemVer tags")]:::artifact
    rtest --> qemu --> image --> ghcr
  end

  subgraph runtime["셀프호스트 런타임"]
    direction LR
    compose["Docker Compose<br/>DBTower + meta-db"]:::runtime
    app["DBTower<br/>Actuator · Prometheus"]:::runtime
    meta[("PostgreSQL 16<br/>볼륨 · Flyway V41")]:::data
    backup[("백업 볼륨<br/>선택: S3 호환 원격 보관")]:::data
    compose --> app
    compose --> meta
    app --> backup
  end

  subgraph provision["관리 대상 프로비저닝 · 앱 배포와 분리"]
    direction LR
    k8s["Kubernetes / kind<br/>CloudNativePG CR"]:::infra
    secret["Secret + 등록 Job<br/>멱등 PUT /api/instances"]:::infra
    ansible["Ansible<br/>최소 권한 계정 · changed=0"]:::infra
    terraform["Terraform<br/>RDS module validate"]:::infra
    managed[("관리 대상 DB<br/>온프레미스 · VM · Kubernetes · Cloud")]:::target
    k8s --> secret --> managed
    ansible --> managed
    terraform --> managed
  end

  source --> ci
  source -->|vX.Y.Z · workflow_dispatch| release
  ghcr --> compose
  app -->|TLS · 최소 권한 계정| managed

  note["검증 범위<br/>Kubernetes: CNPG 생성→Secret→등록→health up 실측<br/>Terraform: provider schema validate, 실제 apply 안 함<br/>ArgoCD · Canary · Blue/Green · OpenShift는 구현 주장 안 함"]:::note
  note -.-> provision

  classDef source fill:#edf2f7,stroke:#334155,color:#172033,stroke-width:2px
  classDef ci fill:#e8f7f2,stroke:#087f5b,color:#084c3c
  classDef gate fill:#fff0f0,stroke:#c92a2a,color:#6b1717,stroke-width:2px
  classDef release fill:#eaf4ff,stroke:#1971c2,color:#103d67
  classDef artifact fill:#f3e8ff,stroke:#7e22ce,color:#4a1768
  classDef runtime fill:#fff7d6,stroke:#b7791f,color:#633c0c
  classDef data fill:#ffffff,stroke:#9a6700,color:#5c3c00
  classDef infra fill:#eef2ff,stroke:#4f46e5,color:#25216b
  classDef target fill:#ffffff,stroke:#087f5b,color:#084c3c
  classDef note fill:#f8fafc,stroke:#475569,color:#172033,stroke-dasharray: 5 4
