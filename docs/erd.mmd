---
config:
  look: handDrawn
  handDrawnSeed: 23
  theme: base
  htmlLabels: true
  flowchart:
    curve: basis
  themeVariables:
    fontFamily: "Pretendard, Apple SD Gothic Neo, sans-serif"
    primaryTextColor: "#172033"
    lineColor: "#52606d"
    clusterBkg: "#ffffff"
    clusterBorder: "#9aa5b1"
---
flowchart LR
  instance["database_instance<br/><b>PK</b> id · <b>UQ</b> name<br/>type · endpoint · team · environment<br/>TLS · collection · app schema"]:::core

  subgraph observe["관측 데이터 · 시간에 따라 누적"]
    query["query_snapshot_part<br/><b>FK</b> instance_id<br/>query_id · counters · captured_at<br/>월별 RANGE partition"]:::observe
    health["health_sample_part<br/><b>FK</b> instance_id<br/>up · ping_millis · sampled_at<br/>월별 RANGE partition"]:::observe
    plan["plan_snapshot<br/><b>FK</b> instance_id<br/>query_id · plan_hash · shape"]:::observe
    runtime["wait_event_snapshot<br/>size_snapshot<br/>index_usage_snapshot<br/>ash_sample + tick"]:::observe
    config["config_snapshot<br/>config_param_change<br/>config_current_param"]:::observe
  end

  subgraph govern["조회와 변경의 증거 사슬"]
    worksheet["workbench_worksheet<br/>chat_message<br/>sql_version · setting"]:::govern
    qlog["workbench_query_log<br/>principal · SQL hash<br/>duration · result shape"]:::govern
    review["review_request<br/>requester · approver<br/>status · SQL · reason"]:::gate
    execution["workbench_change_execution<br/>ticket · operator · status<br/>row image · verify · rollback"]:::gate
    masking["masking_rule<br/>instance · schema · table · column"]:::govern
  end

  subgraph operate["운영 자동화"]
    policy["backup_policy_entity<br/><b>FK</b> instance_id · type<br/>interval · retention"]:::operate
    run["backup_run<br/><b>FK</b> instance_id<br/>status · verify · remote location"]:::operate
    alerts["alert_history<br/>alert_message_index<br/>baseline_longterm"]:::operate
  end

  subgraph trust["신원 · 권한 · 감사"]
    user["platform_user<br/>5 roles · team scopes"]:::trust
    oauth["oauth_client<br/>oauth_token"]:::trust
    credential["instance_credential<br/><b>FK</b> instance_id<br/>READ · WRITE · encrypted secret"]:::trust
    audit["audit_event<br/>principal · action · outcome<br/>인스턴스 삭제와 무관하게 보존"]:::trust
    session["SPRING_SESSION<br/>attributes · login_attempt"]:::trust
  end

  instance --> query
  instance --> health
  instance --> plan
  instance --> runtime
  instance --> config
  instance --> policy
  instance --> run
  instance --> credential
  instance --> qlog
  instance --> masking
  worksheet --> qlog
  review --> execution
  user --> worksheet
  user --> review
  user --> oauth
  user --> session
  user -. 행위 기록 .-> audit

  classDef core fill:#edf2f7,stroke:#334155,color:#172033,stroke-width:2px
  classDef observe fill:#e8f7f2,stroke:#087f5b,color:#084c3c
  classDef govern fill:#eaf4ff,stroke:#1971c2,color:#103d67
  classDef gate fill:#fff0f0,stroke:#c92a2a,color:#6b1717,stroke-width:2px
  classDef operate fill:#fff7d6,stroke:#b7791f,color:#633c0c
  classDef trust fill:#f3e8ff,stroke:#7e22ce,color:#4a1768
