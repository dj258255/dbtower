# AI 운영 작업 실행면 설정 예시 — 실제 값은 .env로 복사해 채우고 커밋하지 않는다.

# DBTower 작업 API (서비스 토큰은 ADMIN 권한이다 — 실행면 프로세스 밖으로 새지 않게)
DBTOWER_URL=http://localhost:8080
DBTOWER_API_TOKEN=
# 알림 링크의 베이스. 사람이 여는 웹 콘솔 주소를 넣는다(비우면 DBTOWER_URL)
DBTOWER_CONSOLE_URL=http://localhost:8080

# 큐 (docker compose --profile aiops up -d aiops-redis)
REDIS_URL=redis://localhost:16379
AI_OPS_STREAM=dbtower:ai-operations
AI_OPS_DEAD_LETTER_STREAM=dbtower:ai-operations:dead
AI_OPS_GROUP=dbtower-ai-workers
AI_OPS_CONSUMER=
AI_OPS_MAX_DELIVERIES=3
# 분석 대기(모델 호출)보다 짧으면 처리 중인 메시지를 다른 실행기가 가져간다 — 실행기가 하트비트로 유휴를 되돌리지만 여유를 둔다
AI_OPS_CLAIM_IDLE_MS=300000
AI_OPS_ANALYZE_TIMEOUT_S=240

# Slack — 서명 키가 없으면 입구가 404다. 채널·사용자는 기본 거부
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_API_BASE=https://slack.com/api
SLACK_CHANNEL_TEAMS=C0000000000=team-a
SLACK_USER_ALLOWLIST=U0000000000

# n8n — 완료 이벤트 웹훅. 서명 키가 없으면 서명 없이 보내고, n8n 워크플로는 서명을 요구한다
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# 참고 자료 검색 (docker compose --profile aiops up -d aiops-vector). 비우면 검색 없이 돈다
KNOWLEDGE_DSN=postgresql://knowledge:knowledge@localhost:15434/knowledge
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# 끝난 작업을 과거 사례로 적재할지 — 켜면 AI 소견이 다음 작업의 참고 자료가 된다
KNOWLEDGE_INGEST_CASES=false

LOG_LEVEL=INFO
