# DBTower 셀프호스트 설정 — cp .env.example .env 후 값을 채우세요.
# 이 파일(.env)은 절대 커밋하지 마세요(.gitignore 에 포함).

# [필수] 메타 DB(플랫폼 저장소) 비밀번호. 앱과 meta-db 컨테이너가 공유한다.
DBTOWER_DB_PASSWORD=change-me-strong-password

# [권장] 관리자 초기 비밀번호. 비우면 앱이 첫 부팅에 랜덤 생성 후 로그로 1회 안내한다.
DBTOWER_ADMIN_PASSWORD=

# [선택] 읽기 전용(VIEWER) 계정 비밀번호. 비우면 viewer 계정을 만들지 않는다.
DBTOWER_VIEWER_PASSWORD=

# [선택] 기계·자동화용 Bearer API 토큰. 세팅하면 사람은 세션 로그인, 기계는 이 토큰으로
#        PUT /api/instances(멱등 등록)·MCP 등을 인증한다. IaC 자동 등록(k8s register-job 등)을
#        쓸 때 [필수] — 이 값과 register 쪽 DBTOWER_TOKEN이 같아야 한다. UI로만 붙일 거면 비워도 된다.
#        생성:  openssl rand -base64 32
DBTOWER_API_TOKEN=

# [필수] 등록 대상 DB의 접속 비밀번호를 저장 시 암호화하는 키(AES-256-GCM).
#        생성:  openssl rand -base64 32
#        docker 프로필(셀프호스트)은 이 키가 없으면 기동을 거부한다(평문 저장 방지).
DBTOWER_ENCRYPTION_KEY=

# [선택] AI 1차 분석용 Anthropic API 키. 비우면 AI 분석 비활성(규칙 기반 지적까지만 동작).
ANTHROPIC_API_KEY=

# [선택] 이상 감지 알림 웹훅 URL(Discord/Slack 호환). 비우면 알림 비활성.
DBTOWER_WEBHOOK_URL=

# [선택] 백업 원격 보관 — S3 호환(AWS S3·MinIO·R2). 3-2-1의 오프사이트.
#        endpoint 비우면 AWS S3, MinIO 등은 예: http://minio:9000
DBTOWER_BACKUP_REMOTE_ENABLED=false
DBTOWER_BACKUP_REMOTE_ENDPOINT=
DBTOWER_BACKUP_REMOTE_BUCKET=dbtower-backups
DBTOWER_S3_ACCESS_KEY=
DBTOWER_S3_SECRET_KEY=

# [선택] 노출 포트 / 이미지 태그 / JVM 옵션
DBTOWER_PORT=8080
DBTOWER_TAG=latest
JAVA_OPTS=-XX:MaxRAMPercentage=75
